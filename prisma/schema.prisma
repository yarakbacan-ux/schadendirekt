generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

enum ImportStatus {
  PENDING
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
}

enum DataQuality {
  UNVERIFIED
  PARTIAL
  VERIFIED
  REJECTED
}

enum VehicleEventType {
  ODOMETER_READING
  DAMAGE_RECORD
  INSPECTION
  REGISTRATION
  SALE_LISTING
  SERVICE
  RECALL
  IMPORT_EXPORT
  OTHER
}

model Vehicle {
  id                 String             @id @default(cuid())
  vin                String             @unique @db.VarChar(17)
  make               String?
  model              String?
  modelYear          Int?
  bodyClass          String?
  fuelType           String?
  engineDisplacement Float?
  enginePowerKw      Float?
  transmission       String?
  manufacturer       String?
  plantCountry       String?
  vehicleType        String?
  market             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  events             VehicleEvent[]
  attributes         VehicleAttribute[]

  @@index([vin])
}

model VehicleEvent {
  id                  String           @id @default(cuid())
  vehicleId           String
  sourceId            String
  externalId          String?
  eventType           VehicleEventType @default(OTHER)
  sourceEventType     String?
  eventDate           DateTime?
  country             String?          @db.VarChar(2)
  mileageKm           Int?
  title               String
  description         String?
  rawPayload          Json?
  rawPayloadExpiresAt DateTime?
  quality             DataQuality      @default(UNVERIFIED)
  occurredAtText      String?
  importedAt          DateTime         @default(now())
  vehicle             Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  source              DataSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId])
  @@index([vehicleId, eventDate])
  @@index([eventType])
  @@index([sourceId])
  @@index([rawPayloadExpiresAt])
}

model VehicleAttribute {
  id          String      @id @default(cuid())
  vehicleId   String
  sourceId    String
  field       String
  value       String      @db.Text
  sourceField String?
  rawValue    String?     @db.Text
  quality     DataQuality @default(UNVERIFIED)
  fetchedAt   DateTime    @default(now())
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  source      DataSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, sourceId, field])
  @@index([vehicleId, field])
  @@index([sourceId])
}

model VinDecodeCache {
  vin       String   @id @db.VarChar(17)
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model DataSource {
  id                String             @id @default(cuid())
  key               String             @unique
  name              String
  description       String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  events            VehicleEvent[]
  vehicleAttributes VehicleAttribute[]
  importJobs        ImportJob[]
  licenses          SourceLicense[]
}

model ImportJob {
  id            String        @id @default(cuid())
  sourceId      String
  status        ImportStatus  @default(PENDING)
  format        String
  fileName      String?
  checksum      String?
  rowsRead      Int           @default(0)
  rowsValidated Int           @default(0)
  rowsWritten   Int           @default(0)
  rowsFailed    Int           @default(0)
  errorLog      Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  source        DataSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  payload       ImportPayload?
  object        ImportObject?

  @@index([sourceId, createdAt])
  @@index([status])
  @@index([checksum])
}

// Legacy compatibility for pre-hardening jobs. New uploads use ImportObject + external storage.
model ImportPayload {
  id          String    @id @default(cuid())
  importJobId String    @unique
  content     String    @db.Text
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ImportObject {
  id          String    @id @default(cuid())
  importJobId String    @unique
  provider    String
  storageKey  String    @unique
  sizeBytes   Int
  checksum    String
  expiresAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([deletedAt])
}

model SourceLicense {
  id                  String     @id @default(cuid())
  sourceId            String
  licenseName         String
  termsUrl            String?
  canStore             Boolean    @default(false)
  canRedistribute      Boolean    @default(false)
  canCommercialize     Boolean    @default(false)
  retentionDays        Int?
  notes                String?
  validFrom            DateTime?
  validUntil           DateTime?
  reviewedAt           DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  source               DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([validFrom, validUntil])
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         UserRole       @default(VIEWER)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  authLogs     AuthAuditLog[]
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique
  csrfTokenHash String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
}
