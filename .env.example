DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schadendirekt?schema=public"
WORKER_TOKEN="replace-with-a-long-random-secret"

# Nur aktivieren, wenn die Anwendung ausschließlich hinter einem kontrollierten Reverse Proxy läuft,
# der X-Forwarded-For / X-Real-IP selbst setzt bzw. bereinigt.
TRUST_PROXY="false"

# Provider-Rate-Limits: in Produktion ist ein geteilter Redis-kompatibler REST-Store Pflicht.
# In Dev/Test darf RATE_LIMIT_STORE leer bleiben und verwendet dann In-Memory.
RATE_LIMIT_STORE=""
REDIS_REST_URL=""
REDIS_REST_TOKEN=""

# Import-Object-Storage. In Produktion ist IMPORT_STORAGE_DRIVER=s3 Pflicht.
# Der Treiber nutzt einen S3-kompatiblen Endpoint (AWS S3, Cloudflare R2, MinIO) und streamt Upload/Download.
# Dev/CI darf local verwenden.
IMPORT_STORAGE_DRIVER=""
IMPORT_STORAGE_DIR="/tmp/schadendirekt-imports"
IMPORT_MAX_BYTES="5368709120"
IMPORT_STORAGE_S3_ENDPOINT=""
IMPORT_STORAGE_S3_REGION="auto"
IMPORT_STORAGE_S3_BUCKET=""
IMPORT_STORAGE_S3_ACCESS_KEY_ID=""
IMPORT_STORAGE_S3_SECRET_ACCESS_KEY=""
IMPORT_STORAGE_S3_SESSION_TOKEN=""

# NHTSA-Rechte werden NICHT durch Runtime-Code freigeschaltet. Diese Werte werden nur für den
# expliziten Admin-Befehl `npm run license:approve-nhtsa` verwendet, nachdem die Terms tatsächlich geprüft wurden.
NHTSA_LICENSE_APPROVAL=""
NHTSA_LICENSE_REVIEWED_BY=""
NHTSA_LICENSE_TERMS_URL=""
NHTSA_LICENSE_NOTES=""

# DVSA MOT History: echte Werte erst nach erfolgreicher Registrierung bei DVSA eintragen.
# Die API verwendet OAuth 2.0 Client Credentials plus X-API-Key. Keine Werte committen.
DVSA_CLIENT_ID=""
DVSA_CLIENT_SECRET=""
DVSA_SCOPE_URL=""
DVSA_TOKEN_URL=""
DVSA_API_KEY=""
DVSA_BASE_URL="https://history.mot.api.gov.uk"

# Rechte nur nach tatsächlicher Prüfung über `npm run license:configure-dvsa` eintragen.
# Es gibt absichtlich keine automatisch freigeschalteten Defaults.
DVSA_LICENSE_APPROVAL=""
DVSA_LICENSE_REVIEWED_BY=""
DVSA_LICENSE_TERMS_URL=""
DVSA_LICENSE_NOTES=""
DVSA_LICENSE_CAN_STORE="false"
DVSA_LICENSE_CAN_REDISTRIBUTE="false"
DVSA_LICENSE_CAN_COMMERCIALIZE="false"
DVSA_LICENSE_RETENTION_DAYS=""
