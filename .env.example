DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schadendirekt?schema=public"
WORKER_TOKEN="replace-with-a-long-random-secret"

# Nur aktivieren, wenn die Anwendung ausschließlich hinter einem kontrollierten Reverse Proxy läuft,
# der X-Forwarded-For / X-Real-IP selbst setzt bzw. bereinigt.
TRUST_PROXY="false"

# Lokaler Import-Object-Storage für Entwicklung/CI. Produktion soll einen S3/R2/MinIO-kompatiblen
# Adapter hinter ImportStorage verwenden.
IMPORT_STORAGE_DIR="/tmp/schadendirekt-imports"

# NHTSA-Rechte werden NICHT durch Runtime-Code freigeschaltet. Diese Werte werden nur für den
# expliziten Admin-Befehl `npm run license:approve-nhtsa` verwendet, nachdem die Terms tatsächlich geprüft wurden.
NHTSA_LICENSE_APPROVAL=""
NHTSA_LICENSE_REVIEWED_BY=""
NHTSA_LICENSE_TERMS_URL=""
NHTSA_LICENSE_NOTES=""

# DVSA MOT History: echte Werte erst nach erfolgreicher Registrierung bei DVSA eintragen.
# Die API verwendet OAuth 2.0 Client Credentials plus X-API-Key. Keine Werte committen.
DVSA_CLIENT_ID=""
DVSA_CLIENT_SECRET=""
DVSA_SCOPE_URL=""
DVSA_TOKEN_URL=""
DVSA_API_KEY=""
DVSA_BASE_URL="https://history.mot.api.gov.uk"
