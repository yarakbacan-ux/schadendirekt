generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

enum ImportStatus {
  PENDING
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
}

enum DataQuality {
  UNVERIFIED
  PARTIAL
  TECHNICALLY_VALID
  VERIFIED
  CONFLICTING
  STALE
  INCOMPLETE
  REJECTED
}

enum VehicleEventType {
  ODOMETER_READING
  DAMAGE_RECORD
  INSPECTION
  REGISTRATION
  SALE_LISTING
  SERVICE
  RECALL
  IMPORT_EXPORT
  OTHER
}

enum VehicleOrigin {
  PUBLIC_LOOKUP
  ADMIN_IMPORT
  REPORT_PURCHASE
  SYSTEM
}

enum ProviderRunStatus {
  SUCCESS
  NO_DATA
  NOT_APPLICABLE
  FAILED
  SKIPPED
}

enum CoverageStatus {
  LIVE
  PARTIAL
  PLANNED
  UNAVAILABLE
}

enum ProviderAuthType {
  NONE
  API_KEY
  OAUTH2
  OAUTH2_API_KEY
  CONTRACT
  BULK_FILE
}

model Vehicle {
  id                 String             @id @default(cuid())
  vin                String             @unique @db.VarChar(17)
  origin             VehicleOrigin      @default(SYSTEM)
  make               String?
  model              String?
  modelYear          Int?
  bodyClass          String?
  fuelType           String?
  engineDisplacement Float?
  enginePowerKw      Float?
  transmission       String?
  manufacturer       String?
  plantCountry       String?
  vehicleType        String?
  market             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  events             VehicleEvent[]
  attributes         VehicleAttribute[]

  @@index([vin])
  @@index([origin])
}

model VehicleEvent {
  id                  String           @id @default(cuid())
  vehicleId           String
  sourceId            String
  externalId          String?
  eventType           VehicleEventType @default(OTHER)
  sourceEventType     String?
  eventDate           DateTime?
  country             String?          @db.VarChar(2)
  mileageKm           Int?
  title               String
  description         String?
  rawPayload          Json?
  rawPayloadExpiresAt DateTime?
  quality             DataQuality      @default(UNVERIFIED)
  conflict            Boolean          @default(false)
  mappingVersion      String?
  occurredAtText      String?
  importedAt          DateTime         @default(now())
  vehicle             Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  source              DataSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId])
  @@index([vehicleId, eventDate])
  @@index([eventType])
  @@index([sourceId])
  @@index([conflict])
  @@index([rawPayloadExpiresAt])
}

model VehicleAttribute {
  id             String      @id @default(cuid())
  vehicleId      String
  sourceId       String
  field          String
  value          String      @db.Text
  sourceField    String?
  rawValue       String?     @db.Text
  quality        DataQuality @default(UNVERIFIED)
  conflict       Boolean     @default(false)
  mappingVersion String?
  fetchedAt      DateTime    @default(now())
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  source         DataSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, sourceId, field])
  @@index([vehicleId, field])
  @@index([sourceId])
  @@index([conflict])
}

model VinDecodeCache {
  vin       String   @id @db.VarChar(17)
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model DataSource {
  id                String             @id @default(cuid())
  key               String             @unique
  name              String
  description       String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  events            VehicleEvent[]
  vehicleAttributes VehicleAttribute[]
  importJobs        ImportJob[]
  licenses          SourceLicense[]
  contracts         SourceContract[]
  providerRuns      ProviderRun[]
  coverages         ProviderCoverage[]
}

model ProviderCoverage {
  id                String           @id @default(cuid())
  sourceId          String
  market            String
  capability        String
  status            CoverageStatus
  earliestDate      DateTime?
  latestDate        DateTime?
  requirements      Json?
  qualityNote       String?
  authType          ProviderAuthType @default(NONE)
  freshnessSeconds  Int?
  mappingVersion    String?
  lastSuccessfulAt  DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  source            DataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, market, capability])
  @@index([market, status])
  @@index([sourceId, status])
}

model ProviderRun {
  id             String            @id @default(cuid())
  sourceId       String
  vin            String?           @db.VarChar(17)
  status         ProviderRunStatus
  cached         Boolean           @default(false)
  durationMs     Int
  errorCode      String?
  decisionReason String?
  market         String?
  mappingVersion String?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime          @default(now())
  source         DataSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, finishedAt])
  @@index([status, finishedAt])
  @@index([vin])
}

model ImportJob {
  id             String        @id @default(cuid())
  sourceId       String
  status         ImportStatus  @default(PENDING)
  format         String
  mappingVersion String        @default("generic-import-v1")
  fileName       String?
  checksum       String?
  rowsRead       Int           @default(0)
  rowsValidated  Int           @default(0)
  rowsWritten    Int           @default(0)
  rowsFailed     Int           @default(0)
  errorLog       Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())
  source         DataSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  payload        ImportPayload?
  object         ImportObject?

  @@index([sourceId, createdAt])
  @@index([status])
  @@index([checksum])
  @@index([sourceId, checksum, mappingVersion])
}

model ImportPayload {
  id          String    @id @default(cuid())
  importJobId String    @unique
  content     String    @db.Text
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ImportObject {
  id          String    @id @default(cuid())
  importJobId String    @unique
  provider    String
  storageKey  String    @unique
  sizeBytes   Int
  checksum    String
  expiresAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([deletedAt])
}

model SourceLicense {
  id                  String     @id @default(cuid())
  sourceId            String
  licenseName         String
  termsUrl            String?
  canStore             Boolean    @default(false)
  canRedistribute      Boolean    @default(false)
  canCommercialize     Boolean    @default(false)
  retentionDays        Int?
  notes                String?
  reviewedBy           String?
  validFrom            DateTime?
  validUntil           DateTime?
  reviewedAt           DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  source               DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([validFrom, validUntil])
}

model SourceContract {
  id         String     @id @default(cuid())
  sourceId   String
  name       String
  reference  String?
  active     Boolean    @default(false)
  validFrom  DateTime?
  validUntil DateTime?
  reviewedBy String?
  reviewedAt DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  source     DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, active])
  @@index([validFrom, validUntil])
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         UserRole       @default(VIEWER)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  authLogs     AuthAuditLog[]
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique
  csrfTokenHash String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
}
